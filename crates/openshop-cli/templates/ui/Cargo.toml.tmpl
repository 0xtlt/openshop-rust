[package]
name = "__PACKAGE_NAME__-ui"
description = "Admin UI bundle: the built-in OpenShop screens plus this app's custom pages."
version = "0.1.0"
edition = "2024"
publish = false

# Built with trunk for wasm32; kept out of the server workspace on purpose.
[workspace]

[dependencies]
openshop-ui = { __OPENSHOP_UI_SOURCE__ }

leptos = "0.8"
serde = { version = "1", features = ["derive"] }

[profile.release]
opt-level = "z"
lto = true
codegen-units = 1
panic = "abort"
strip = true
