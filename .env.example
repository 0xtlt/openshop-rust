DATABASE_URL=postgresql://openshop:openshop@localhost:5432/openshop

# Provider config encryption (64 hex chars = 32 bytes). Generate with: openssl rand -hex 32
# If unset, configs are stored in plaintext.
ENCRYPTION_KEY=

# Password of the operator dashboard at /ops: every shop, read-only, outside
# Shopify admin. Without it the dashboard does not exist. At least 16
# characters in production.
# OPS_PASSWORD=
