DATABASE_URL=postgresql://openshop:openshop@localhost:5432/openshop

# Provider config encryption (64 hex chars = 32 bytes). Generate with: openssl rand -hex 32
# Required unless OPENSHOP_ENV is development or test. `dev` stores secrets in
# plaintext when it is unset.
ENCRYPTION_KEY=

# A development store of the organization that owns the app, for example one
# used by automated tests, for which flows, crons, routes, webhook handlers,
# proxies and the MCP tool may get an access token with Shopify's client
# credentials grant when none is stored (after the database was emptied, for
# example). A launch from Shopify admin, or a session token whose exchange
# Shopify refused, already asks for any shop without a token; Shopify
# only grants it to the stores of the app's organization, never to a merchant's
# store.
# SHOPIFY_CLIENT_CREDENTIALS_SHOP=dev-store-1.myshopify.com

# Password of the operator dashboard at /ops: every shop, read-only, outside
# Shopify admin. Without it the dashboard does not exist. At least 16
# characters in production.
# OPS_PASSWORD=

# DSN of the Sentry project the failures are reported to: runs that fail,
# handlers that fail, panics. Without it nothing is reported.
# SENTRY_DSN=
